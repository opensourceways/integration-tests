# .env.example — 复制为 .env 后填入真实凭证
#
#   cp .env.example .env
#
# .env 已被 .gitignore / .dockerignore 双重排除，不会入库、不进镜像层。
# 容器运行时通过 --env-file .env 或 compose 的 env_file 注入。

# ── 必填 ──────────────────────────────────────────────────────────
# GitCode 访问令牌。也可改用文件方式：写入 ~/.gitcode-token（优先级更高）
GITCODE_ACCESS_TOKEN=

# ── UI 用例必填（75 条）────────────────────────────────────────────
# 浏览器登录后的 Cookie 串。缺失时 UI 用例记为 ENV_ERROR，
# 且可能把执行覆盖率压到 60% 以下触发 INCONCLUSIVE（退出码 2）
#
# 获取方式 1（自动，推荐）：
#   填写下方 GITCODE_USERNAME 和 GITCODE_PASSWORD，然后运行：
#     python phase02/scripts/login_helper.py
#   脚本会自动登录并将 Cookie 写入 GITCODE_COOKIE
#
# 获取方式 2（命令行）：
#   python phase02/scripts/login_helper.py <username> <password>
#   将输出的 Cookie 串手动复制到此处
#
# 获取方式 3（手动）：
#   1. 浏览器登录 gitcode.com
#   2. 开发者工具 → Application/Storage → Cookies → gitcode.com
#   3. 复制成 `k=v; k2=v2` 格式填入
GITCODE_USERNAME=
GITCODE_PASSWORD=
GITCODE_COOKIE=

# ── 被测仓（有默认值，按需覆盖）─────────────────────────────────────
GITCODE_OWNER=ComputingActionTest
GITCODE_REPO=bingo
GITCODE_BRANCH=main
GITCODE_API_BASE_URL=https://api.gitcode.com

# 目标 workflow id（默认值来自 phase02/scripts/workflow_runner.py）
GITCODE_WORKFLOW_ID=b03a4b84cd784ddea00c5270eba62c7f

# 指定 runner executor，留空为平台默认
GITCODE_EXECUTOR=

# ── 执行调参（有默认值）────────────────────────────────────────────
# 单条 workflow 用例超时（秒）
PHASE02_CASE_TIMEOUT=300
# 轮询运行状态的间隔（秒）
PHASE02_POLL_INTERVAL=12

# ── api 执行器（86 条 api 用例）─────────────────────────────────────
# 单个 HTTP 请求超时（秒）
API_CASE_TIMEOUT=30
# 请求之间的间隔（秒），避免触发平台限流
API_REQUEST_DELAY=0.3
# 0 = 跳过所有写方法（POST/PUT/PATCH/DELETE），记 INCONCLUSIVE
API_ALLOW_WRITE=1
# 1 = 允许「直打真实资源」的 32 条写请求（含合并 PR、转移仓库等不可逆操作）。
#     默认 0 跳过。确认目标是专用测试仓后再开，详见 README「api 执行器的安全门禁」
API_ALLOW_UNSAFE_WRITE=0

# ── ui 执行器（75 条 ui 用例，需 Playwright Chromium）─────────────────
# 0 = 有头模式（本地调试用），CI 保持 1
UI_HEADLESS=1
# 页面导航超时（毫秒）
UI_NAV_TIMEOUT=30000
# 单个 action 超时（毫秒）
UI_ACTION_TIMEOUT=15000
# SPA 渲染静默等待（毫秒）。GitCode 是 SPA，domcontentloaded 时 body 已存在但
# 内容未渲染；不等静默会让断言与渲染赛跑，同一条用例出现 PASS/FAIL 漂移
UI_SETTLE_TIMEOUT=10000

# ── git 执行器（5 条 git 用例）───────────────────────────────────────
# 1 = 执行 push 用例（写入真实仓）。默认 0 跳过
GIT_ALLOW_PUSH=0
# 单条 git 命令超时（秒）；大仓 clone 用例需要较大值
GIT_CASE_TIMEOUT=900
# GIT-CLONE-01-002 用 ${PAT_TOKEN} 做 HTTPS 鉴权，需在此提供
PAT_TOKEN=
# 门禁：执行覆盖率低于此值判 INCONCLUSIVE（退出码 2）
MIN_EXECUTION_COVERAGE=0.6

# 时区（影响 run-id 时间戳与报告时间）
TZ=Asia/Shanghai
