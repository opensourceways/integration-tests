// Jenkinsfile — GitCode Actions 每日回归（全量 249 条）
//
// Job 配置: Pipeline script from SCM → Script Path = gitcode_services/Jenkinsfile
// 凭证需先在 Jenkins 建好（见 gitcode_services/JENKINS-SETUP.md）
//
// 本包自包含：引擎已 vendor 在 gitcode_services/phase02/scripts，
// agent 上无需存在上游仓即可执行。

pipeline {
    agent { label 'linux' }

    triggers {
        // UTC 02:00 = 北京时间 10:00
        cron('0 2 * * *')
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 2, unit: 'HOURS')
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        PKG_DIR = 'gitcode_services'

        GITCODE_ACCESS_TOKEN = credentials('gitcode-access-token')
        // UI 用例需要登录态；未配置时这些用例记为 ENV_ERROR
        GITCODE_COOKIE = credentials('gitcode-cookie')

        MIN_EXECUTION_COVERAGE = '0.6'
        CASE_SET               = 'cases/yaml'
        RUN_PREFIX             = 'daily'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                dir("${PKG_DIR}") {
                    sh '''
                        set -e
                        python3 --version
                        pip3 install -q -r requirements.txt
                        python3 -c "from playwright.sync_api import sync_playwright" \
                            || echo "警告: Playwright 不可用，75 条 UI 用例将记为 ENV_ERROR"
                    '''
                }
            }
        }

        stage('上游漂移检查') {
            steps {
                dir("${PKG_DIR}") {
                    // 上游仓在 agent 上通常不存在；缺失或漂移都只告警，不阻断
                    sh '''
                        chmod +x sync-cases.sh
                        ./sync-cases.sh --check \
                            || echo "警告: 未检出上游或存在漂移，本次按本包 vendored 内容执行"
                    '''
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir("${PKG_DIR}") {
                    sh '''
                        chmod +x run_daily.sh
                        ./run_daily.sh "$CASE_SET" "$RUN_PREFIX"
                    '''
                }
            }
        }
    }

    post {
        always {
            junit(
                testResults: "${PKG_DIR}/phase02/runs/daily-*/junit.xml",
                allowEmptyResults: false
            )
            archiveArtifacts(
                artifacts: "${PKG_DIR}/phase02/reports/daily-*/**/*," +
                           "${PKG_DIR}/phase02/runs/daily-*/summary.json," +
                           "${PKG_DIR}/phase02/runs/daily-*/junit.xml",
                fingerprint: true,
                allowEmptyArchive: true
            )
        }
        cleanup {
            sh "rm -f ${PKG_DIR}/*.log.txt || true"
        }
    }
}
