================================
var community_tem = community
var sql = """SELECT 
    assign_user,
    COUNT(DISTINCT html_url) AS got_issues,
    COUNT(DISTINCT html_url) FILTER (WHERE issue_state = 'closed') AS completed_issues,
    '0' as star
FROM 
    fact_${community_tem}_practice
WHERE 
    assign_user IS NOT NULL
GROUP BY 
    assign_user
 """
return db.select(sql)
