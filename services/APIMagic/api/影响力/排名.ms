var sqlstr = """
SELECT 
    name,
    rank_last_1_month,
    score_last_1_month,
    rank_last_3_months,
    score_last_3_months,
    rank_last_6_months,
    score_last_6_months,
    rank_last_12_months,
    score_last_12_months
FROM 
    fact_distrowatch_rank
ORDER BY rank_last_1_month asc;"""
var resp = db.select(sqlstr)
return resp
