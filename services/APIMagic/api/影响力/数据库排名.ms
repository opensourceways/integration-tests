================================
var sqlstr = """
SELECT 
    name,
    rank_now,
    rank_last_month,
    rank_last_year,
    score_now,
    score_last_month,
    score_last_year
FROM 
    fact_db_engine_rank
ORDER BY rank_now asc;"""
var resp = db.select(sqlstr)
return resp
