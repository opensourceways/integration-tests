================================
import '@/util/timestamp2Date' as timestamp2Date;
Date start = timestamp2Date(body.start);
Date end = timestamp2Date(body.end);
var source = body.source;
var community = body.community;
var is_domestic = body.is_domestic;
var start_time =date_format(start,'yyyy-MM-dd');
var end_time =date_format(end,'yyyy-MM-dd');
var base ="基础规范"
var firmware ="固件规范"
var design ="使能操作系统参考设计"
var arch ="超节点参考架构白皮书"
var sql="""
       SELECT  
    country,
        CASE 
        WHEN TRIM(country) = 'Hong Kong' THEN 'Hong Kong'
        ELSE region 
    END,
    city,
    SUM(
        CASE 
            WHEN TRIM(title) like '%' || #{base} 
            THEN 1 
            ELSE 0 
        END
    ) AS base_download_count,
    SUM(
        CASE 
            WHEN TRIM(title) like '%' || #{firmware} 
            THEN 1 
            ELSE 0 
        END
    ) AS firmware_download_count,
    SUM(
        CASE 
            WHEN TRIM(title) like '%' || #{design} 
            THEN 1 
            ELSE 0 
        END
    ) AS design_download_count,
    SUM(
        CASE 
            WHEN TRIM(title) like '%' || #{arch}  
            THEN 1 
            ELSE 0 
        END
    ) AS arch_download_count,
    COUNT(*) AS download_count
    FROM dwm_${community}_detail_download_daily
    WHERE 
        created_at >= #{start_time}::date 
        AND created_at <= #{end_time}::date
        <if test="source != null and source != ''">
            AND source = #{source}
        </if>
        <if test="is_domestic != null and is_domestic != ''">
            AND is_domestic = #{is_domestic}
        </if>
    GROUP BY 
    country, 
    CASE 
        WHEN TRIM(country) = 'Hong Kong' THEN 'Hong Kong'
        ELSE region 
    END, 
    city
""";
return db.select(sql);