var sqlstr = """
SELECT 
    sig_name, mailing_list, array_agg(maintainers) as maintainers, array_agg(committers) as committers
FROM 
    fact_${community}_sig_info
WHERE is_removed IS NULL
GROUP by sig_name, mailing_list;"""
var resp = db.select(sqlstr)
var result = resp.map(re => {
    return {
        sig_name: re['sig_name'],
        mailing_list: re['mailing_list'],
        maintainers: re['maintainers'].getArray().filter(it => it != null).map(it => it::json)[0],
        committers: re['committers'].getArray().filter(it => it != null).map(it => it::json)[0]
    };
});
return result;
