import java.lang.reflect.Array
var community = community
// var sigSql = """select * from fact_${community}_siginfo_sigs""";
var sigSql = """select * from fact_${community}_sig_detail_info where is_removed is null""";
var sigs = db.select(sigSql);
ArrayList sigjsonList = new ArrayList();
// 查看sig的所有maintainers
for( item in sigs){
    var sig_name = item.get("sig_name");
   var sig_content = item.get("sig_json")::json;
   //  var sqlMa = """select distinct from fact_${community}_siginfo_sig_maintainers where sig_name='${sig_name}'""" ;
   //  item.put("maintainers",db.select(sqlMa));
    var  sigRepos = db.select("""select distinct concat(namespace,'/',repo_path) as repo_name from fact_${community}_sig_user where sig_name=#{sig_name} and is_removed is null """);
    sig_content.put("repo_count",sigRepos.size());
    sig_content.put("repos",sigRepos);
    sigjsonList.add(sig_content)
}
HashMap res = new HashMap();
var repoSql = """select distinct concat(namespace,'/',repo_path) as repo_name from fact_${community}_sig_user where  is_removed is null """
res.put("sigList",sigjsonList);
var repos = db.select(repoSql);
for (repo in repos) {
    var repsName = repo.get("repo_name");
    String link = "";
    if(repsName.startsWith("/mindspore/mindspore")){
        link = "https://gitee.com/mindspore/mindspore/tree/master/"+repsName.replaceFirst("/mindspore/mindspore","");
    }else if (repsName.startsWith("mindspore/mindspore")){
        link = "https://gitee.com/mindspore/mindspore/tree/master/"+repsName.replaceFirst("mindspore/mindspore","");
    }else{
        link = "https://gitee.com/"+repsName;    
    } 
    repo.put("herf_link",link)
}
res.put("repos",repos)
return res
