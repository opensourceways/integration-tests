    }],\n            \"repo_count\": 1,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/akg\"\n            }]\n        }, {\n            \"name\": \"LLM Inference Serving\",\n            \"description\": \"MindSpore大模型推理服务组（LLM Inference Serving SIG）致力于实现vLLM等开源推理服务框架与MindSpore推理能力的兼容互通，通过整合二者技术长板，提供高性能、易用的大模型推理服务能力。\",\n            \"description_en\": \"The MindSpore LLM Inference Serving SIG is dedicated to achieving compatibility and interconnection between open-source inference service frameworks such as vLLM and MindSpore inference capabilities. By integrating the technical strengths of the two, it provides high-performance and easy-to-use LLM inference service capabilities.\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"maintainers\": [{\n                \"gitee_id\": \"zhaizhiqiang\",\n                \"name\": \"Zhai Zhiqiang\",\n                \"email\": \"zhaizhiqiang@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"zichun_ye\",\n                \"name\": \"Ye Zichun\",\n                \"email\": \"zichun.ye@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"panshaowu\",\n                \"name\": \"Pan Shaowu\",\n                \"email\": \"panshaowu@huawei.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/vllm-mindspore\"],\n                \"repo_admin\": [{\n                    \"gitee_id\": \"zhaizhiqiang\",\n                    \"name\": \"Zhai Zhiqiang\",\n                    \"email\": \"zhaizhiqiang@huawei.com\"\n                }, {\n                    \"gitee_id\": \"zichun_ye\",\n                    \"name\": \"Ye Zichun\",\n                    \"email\": \"zichun.ye@huawei.com\"\n                }, {\n                    \"gitee_id\": \"panshaowu\",\n                    \"name\": \"Pan Shaowu\