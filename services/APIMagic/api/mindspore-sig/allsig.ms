g University of Posts and Telecommunications\",\n                    \"email\": \"NA\"\n                }]\n            }],\n            \"repo_count\": 2,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindarmour\"\n            }, {\n                \"repo_name\": \"mindspore/mindspore\"\n            }]\n        }],\n        \"repos\": [{\n            \"repo_name\": \"mindspore/docs\",\n            \"herf_link\": \"https://gitee.com/mindspore/docs\"\n        }, {\n            \"repo_name\": \"mindspore/mindscience\",\n            \"herf_link\": \"https://gitee.com/mindspore/mindscience\"\n        }, {\n            \"repo_name\": \"mindspore/mindquantum\",\n            \"herf_link\": \"https://gitee.com/mindspore/mindquantum\"\n        }, {\n            \"repo_name\": \"mindspore/akg\",\n            \"herf_link\": \"https://gitee.com/mindspore/akg\"\n        }, {\n            \"repo_name\": \"mindspore/mindspore-lite\",\n            \"herf_link\": \"https://gitee.com/mindspore/mindspore/tree/master/-lite\"\n        }, {\n            \"repo_name\": \"mindspore/mindspore\",\n            \"herf_link\": \"https://gitee.com/mindspore/mindspore/tree/master/\"\n        }, {\n            \"repo_name\": \"mindspore/mindformers\",\n            \"herf_link\": \"https://gitee.com/mindspore/mindformers\"\n        }, {\n            \"repo_name\": \"mindspore/mindarmour\",\n            \"herf_link\": \"https://gitee.com/mindspore/mindarmour\"\n        }, {\n            \"repo_name\": \"mindspore/vllm-mindspore\",\n            \"herf_link\": \"https://gitee.com/mindspore/vllm-mindspore\"\n        }]\n    },\n    \"timestamp\": 1761124819004,\n    \"executeTime\": null\n}",
