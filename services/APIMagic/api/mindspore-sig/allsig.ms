  "responseBody" : "{\n    \"code\": 1,\n    \"message\": \"success\",\n    \"data\": {\n        \"sigList\": [{\n            \"name\": \"MindSpore Science\",\n            \"description\": \"MindScience是基于MindSpore融合架构打造的科学计算行业套件，包含了业界领先的数据集、基础模型、预置高精度模型和前后处理工具，加速了科学行业应用开发。MindSpore Science SIG旨在与广大开发者共同将AI与科学计算相结合，助力科学计算借助AI的强大计算能力探索未知领域，提升计算效率和准确性，更好地应对复杂地科学计算问题。\",\n            \"description_en\": \"The MindSpore Science SIG aims to combine AI with scientific computing, leveraging the powerful computing capabilities of AI to explore unknown fields, improve computing efficiency and accuracy, and better address complex scientific computing issues.\",\n            \"created_on\": \"2025-05-15\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"maintainers\": [{\n                \"gitee_id\": \"hsliu_ustc\",\n                \"name\": \"hsliu_ustc\",\n                \"organization\": \"Huawei\",\n                \"email\": \"liuhongsheng4@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"gracezou\",\n                \"name\": \"gracezou\",\n                \"organization\": \"Huawei\",\n                \"email\": \"zoujingyuan@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"yanglong_unimelb\",\n                \"name\": \"yanglong_unimelb\",\n                \"organization\": \"Huawei\",\n                \"email\": \"longyangyang1@huawei.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/mindscience\"],\n                \"committers\": [{\n                    \"gitee_id\": \"b_rookie\",\n                    \"name\": \"b_rookie\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"guoboqiang@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"mengqinghe0909\",\n                    \"name\": \"mengqinghe0909\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"qinghe.meng@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"zzzcseth\",\n                    \"name\": \"zzzcseth\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"zhouchuansai@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"yangs-siyu9777\",\n                    \"name\": \"yangs-siyu9777\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"yangsiyu8@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"wangbo572\",\n                    \"name\": \"wangbo572\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"wangbo572@huawei.com\",\n                    \"role\": \"committer\"\n                }]\n            }],\n            \"repo_count\": 1,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindscience\"\n            }]\n        }, {\n            \"name\": \"MindSpore Lite\",\n            \"description\": \"MindSpore Lite面向多种硬件后端设备（昇腾、麒麟等）提供轻量化AI推理加速能力，使能智能应用，为开发者提供端到端的解决方案，为算法工程师和数据科学家提供开发友好、运行高效、部署灵活的体验。\",\n            \"description_en\": \"MindSpore Lite provides lightweight AI inference acceleration capabilities for a variety of hardware backend devices (Ascend, Kirin, etc.), enabling intelligent applications, providing developers with end-to-end solutions, and offering algorithm engineers and data scientists a development-friendly, efficient, and flexible deployment experience.\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"maintainers\": [{\n                \"gitee_id\": \"jjfeing\",\n                \"name\": \"Jiang Jianfei\",\n                \"email\": \"jiangjianfei3@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"fatmouse007fatmouse007\",\n                \"name\": \"Zhu Guodong\",\n                \"email\": \"zhuguodong8@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"YeFeng_24\",\n                \"name\": \"Ye Feng\",\n                \"email\": \"yefeng24@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"xu_anyue\",\n                \"name\": \"Xu Anyue\",\n                \"email\": \"xuanyue@huawei.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/mindspore-lite\"],\n                \"repo_admin\": [{\n                    \"gitee_id\": \"jjfeing\",\n                    \"name\": \"Jiang Jianfei\",\n                    \"email\": \"jiangjianfei3@huawei.com\"\n                }, {\n                    \"gitee_id\": \"fatmouse007fatmouse007\",\n                    \"name\": \"Zhu Guodong\",\n                    \"email\": \"zhuguodong8@huawei.com\"\n                }, {\n                    \"gitee_id\": \"YeFeng_24\",\n                    \"name\": \"Ye Feng\",\n                    \"email\": \"yefeng24@huawei.com\"\n                }, {\n                    \"gitee_id\": \"xu_anyue\",\n                    \"name\": \"Xu Anyue\",\n                    \"email\": \"xuanyue@huawei.com\"\n                }],\n                \"committers\": [{\n                    \"gitee_id\": \"jianghui58\",\n                    \"name\": \"Jiang Hui\",\n                    \"email\": \"jianghui58@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"ljl0711\",\n                    \"name\": \"Lu jiale\",\n                    \"email\": \"lujiale@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"zgstar\",\n                    \"name\": \"Zhang Qi\",\n                    \"email\": \"zhangqi92@huawei.com\",\n                    \"role\": \"committer\"\n                }],\n                \"contributors\": [{\n                    \"gitee_id\": \"yangyingchun1999\",\n                    \"name\": \"Yang Yingchun\",\n                    \"email\": \"yangyingchun5@huawei.com\"\n                }, {\n                    \"gitee_id\": \"StevenDongyu\",\n                    \"name\": \"Zhang Dongyu\",\n                    \"email\": \"zhangdongyu11@huawei.com\"\n                }, {\n                    \"gitee_id\": \"gupengcheng0401\",\n                    \"name\": \"Gu Pengcheng\",\n                    \"email\": \"gupengcheng4@huawei.com\"\n                }, {\n                    \"gitee_id\": \"chengfeng27\",\n                    \"name\": \"Cheng Feng\",\n                    \"email\": \"chengfeng27@huawei.com\"\n                }]\n            }],\n            \"branches\": [{\n                \"repo_branch\": [{\n                    \"repo\": \"mindspore/mindspore-lite\",\n                    \"branch\": \"master\"\n                }],\n                \"keeper\": [{\n                    \"gitee_id\": \"ljl0711\"\n                }]\n            }],\n            \"repo_count\": 1,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindspore-lite\"\n            }]\n        }, {\n            \"name\": \"Heterogeneous Fusion\",\n            \"description\": \"基于MindSpore构建开放的南向接口，协同业界厂商和学术机构，构建异构融合加速能力和使能全场景部署与应用。\",\n            \"description_en\": \"MindSpore is used to build open southbound interfaces. MindSpore collaborates with industry vendors and academic institutions to build heterogeneous convergence acceleration capabilities and enable all-scenario deployment and application.\",\n            \"created_on\": \"2025-05-15\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"meeting_url\": \"NA\",\n            \"mature_level\": \"startup\",\n            \"mentors\": [{\n                \"gitee_id\": \"limingqi107\",\n                \"name\": \"limingqi\",\n                \"organization\": \"Huawei\",\n                \"email\": \"limingqi@huawei.com\"\n            }],\n            \"maintainers\": [{\n                \"gitee_id\": \"baochong\",\n                \"name\": \"baochong\",\n                \"organization\": \"Huawei\",\n                \"email\": \"baochong@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"guoqi1024\",\n                \"name\": \"guoqi\",\n                \"organization\": \"Huawei\",\n                \"email\": \"guoqi5@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"limingqi107\",\n                \"name\": \"limingqi\",\n                \"organization\": \"Huawei\",\n                \"email\": \"limingqi@huawei.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/mindspore\"],\n                \"directory\": [\"mindspore/ccsrc/backend\", \"mindspore/ccsrc/plugin\"],\n                \"repo_admin\": [{\n                    \"gitee_id\": \"baochong\",\n                    \"name\": \"baochong\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"baochong@huawei.com\"\n                }, {\n                    \"gitee_id\": \"guoqi1024\",\n                    \"name\": \"guoqi\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"guoqi5@huawei.com\"\n                }, {\n                    \"gitee_id\": \"limingqi107\",\n                    \"name\": \"limingqi\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"limingqi@huawei.com\"\n                }],\n                \"committers\": [{\n                    \"gitee_id\": \"yuchaojie\",\n                    \"name\": \"yuchaojie\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"yuchaojie1@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"zyli2020\",\n                    \"name\": \"lizhenyu\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"lizhenyu13@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"ZPaC\",\n                    \"name\": \"zhoupeichen\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"zhoupeichen@huawei.com\",\n                    \"role\": \"committer\"\n                }],\n                \"contributors\": [{\n                    \"gitee_id\": \"gaoyong10\",\n                    \"name\": \"gaoyong\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"gaoyong10@huawei.com\"\n                }, {\n                    \"gitee_id\": \"hbhb_bin\",\n                    \"name\": \"hubin\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"hubin79@huawei.com\"\n                }]\n            }],\n            \"repo_count\": 1,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindspore\"\n            }]\n        }, {\n            \"name\": \"MindSpore Usability\",\n            \"description\": \"MindSpore 易用性组(Usability SIG)专注于推动MindSpore易用性(Python API/文档/教程/案例)。该小组由华为MindSpore核心开发团队、学术界专家及社区开发者共同组成，致力于提升MindSpore开发者体验。\",\n            \"description_en\": \"The MindSpore Usability SIG focuses on promoting the usability of MindSpore (Python APIs, documents, tutorials, and cases). This SIG is composed of Huawei MindSpore core development team, academic experts, and community developers, and is dedicated to improving the MindSpore developer experience.\",\n            \"created_on\": \"2025-05-15\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"maintainers\": [{\n                \"gitee_id\": \"zwiori\",\n                \"name\": \"Zheng Wei\",\n                \"organization\": \"Huawei\",\n                \"email\": \"victor.zhengwei@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"baochong\",\n                \"name\": \"Bao Chong\",\n                \"organization\": \"Huawei\",\n                \"email\": \"baochong@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"yangzhenzhang\",\n                \"name\": \"Yang ZhenZhang\",\n                \"organization\": \"Huawei\",\n                \"email\": \"yangzhenzhang@huawei.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/mindspore/\"],\n                \"directory\": [\"mindspore/python/mindspore\"],\n                \"repo-admin\": [{\n                    \"gitee_id\": \"zwiori\",\n                    \"name\": \"Zheng Wei\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"victor.zhengwei@huawei.com\"\n                }, {\n                    \"gitee_id\": \"baochong\",\n                    \"name\": \"Bao Chong\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"baochong@huawei.com\"\n                }],\n                \"committers\": [{\n                    \"gitee_id\": \"changzherui\",\n                    \"name\": \"Chang ZheRui\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"changzherui1@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"ginfungv\",\n                    \"name\": \"Yu JianFeng\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"yujianfeng5@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"liangchenghui\",\n                    \"name\": \"Liang ChengHui\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"liangchenghui@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"HulkTang\",\n                    \"name\": \"Tang HuiKang\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"tanghuikang@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"YuFong-Qiu\",\n                    \"name\": \"Qiu YuFeng\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"qiuyufeng3@huawei.com\",\n                    \"role\": \"committer\"\n                }]\n            }, {\n                \"repo\": [\"mindspore/docs\"],\n                \"maintainers\": [{\n                    \"gitee_id\": \"zwiori\",\n                    \"name\": \"Zheng Wei\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"victor.zhengwei@huawei.com\"\n                }, {\n                    \"gitee_id\": \"gemini524\",\n                    \"name\": \"Wang Ting\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"kathy.wangting@huawei.com\"\n                }],\n                \"committers\": [{\n                    \"gitee_id\": \"gemini524\",\n                    \"name\": \"Wang Ting\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"kathy.wangting@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"bleub\",\n                    \"name\": \"Meng Xian\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"mengxian2@huawei.com\",\n                    \"role\": \"committer\"\n                }]\n            }],\n            \"repo_count\": 2,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindspore\"\n            }, {\n                \"repo_name\": \"mindspore/docs\"\n            }]\n        }, {\n            \"name\": \"MindSpore PyNative\",\n            \"description\": \"MindSpore PyNative SIG（动态图模式框架开发SIG）专注于推动MindSpore动态图（即时执行， Eager Execution）模式的研发与优化，致力于提升动态图模式的性能、灵活性和易用性，以满足深度学习领域对快速开发、调试、执行等的需求。\",\n            \"description_en\": \"The MindSpore PyNative SIG focuses on promoting the R&D and optimization of the MindSpore dynamic graph (eager execution) mode, and is dedicated to improving the performance, flexibility, and usability of the dynamic graph mode to meet the requirements of the deep learning field for fast development, debugging, and execution.\",\n            \"created_on\": \"2025-05-15\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"meeting_url\": \"NA\",\n            \"mature_level\": \"startup\",\n            \"mentors\": [{\n                \"gitee_id\": \"chujinjin\",\n                \"name\": \"chujinjin\",\n                \"organization\": \"Huawei\",\n                \"email\": \"chujinjin52@huawei.com\"\n            }],\n            \"maintainers\": [{\n                \"gitee_id\": \"chujinjin\",\n                \"name\": \"chujinjin\",\n                \"organization\": \"Huawei\",\n                \"email\": \"chujinjin52@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"baochong\",\n                \"name\": \"baochong\",\n                \"organization\": \"Huawei\",\n                \"email\": \"baochong@huawei.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/mindspore\"],\n                \"directory\": [\"mindspore/ccsrc/pynative\", \"mindspore/ccsrc/pyboost\", \"mindspore/ccsrc/runtime/pynative\"],\n                \"repo_admin\": [{\n                    \"gitee_id\": \"chujinjin\",\n                    \"name\": \"chujinjin\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"chujinjin52@huawei.com\"\n                }, {\n                    \"gitee_id\": \"baochong\",\n                    \"name\": \"baochong\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"baochong@huawei.com\"\n                }],\n                \"committers\": [{\n                    \"gitee_id\": \"hwcaifubi\",\n                    \"name\": \"caifubi\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"caifubi1@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"luochao60\",\n                    \"name\": \"luochao\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"luochao60@huawei.com\",\n                    \"role\": \"committer\"\n                }],\n                \"contributors\": [{\n                    \"gitee_id\": null,\n                    \"name\": \"pengqi\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"pengqi33@huawei.com\"\n                }, {\n                    \"gitee_id\": null,\n                    \"name\": \"maoyuanpeng\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"maoyuanpeng@huawei.com\"\n                }]\n            }],\n            \"repo_count\": 1,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindspore\"\n            }]\n        }, {\n            \"name\": \"MindSpore Transformers\",\n            \"description\": \"MindSpore Transformers SIG（Special Interest Group）是 MindSpore 开源社区下聚焦 Transformer 类大模型全流程开发与优化的技术团队，涵盖大模型的预训练、微调、推理与部署等关键环节。SIG 团队致力于提升 Transformer类大模型在性能与易用性方面的表现，推动其在实际场景中的高效应用与落地。\",\n            \"description_en\": \"The MindSpore Transformers SIG (Special Interest Group) is a technical team under the MindSpore open-source community that focuses on the end-to-end development and optimization of Transformer-based large models, covering key stages such as pre-training, fine-tuning, inference, and deployment. The SIG team is dedicated to enhancing the performance and usability of Transformer-based large models, promoting their efficient application and implementation in real-world scenarios.\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"maintainers\": [{\n                \"gitee_id\": \"Lin-Bert\",\n                \"name\": \"He Qinglin\",\n                \"organization\": \"Huawei\",\n                \"email\": \"heqinglin4@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"suhaibo\",\n                \"name\": \"Su Haibo\",\n                \"organization\": \"Huawei\",\n                \"email\": \"suhaibo1@huawei.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/mindformers\"],\n                \"repo-admin\": [{\n                    \"gitee_id\": \"Lin-Bert\",\n                    \"name\": \"He Qinglin\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"heqinglin4@huawei.com\"\n                }, {\n                    \"gitee_id\": \"suhaibo\",\n                    \"name\": \"Su Haibo\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"suhaibo1@huawei.com\"\n                }],\n                \"committers\": [{\n                    \"gitee_id\": \"hss-shuai\",\n                    \"name\": \"Huang Shengshuai\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"huangshengshuai@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"renyujin\",\n                    \"name\": \"Ren Yujin\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"renyujin1@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"chenrayray\",\n                    \"name\": \"Chen Xinrui\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"chenxinrui11@huawei.com\",\n                    \"role\": \"committer\"\n                }, {\n                    \"gitee_id\": \"zyw-hw\",\n                    \"name\": \"zhang Youwen\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"zhangyouwen7@huawei.com\",\n                    \"role\": \"committer\"\n                }]\n            }],\n            \"repo_count\": 1,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindformers\"\n            }]\n        }, {\n            \"name\": \"MindSpore Quantum\",\n            \"description\": \"MindSpore Quantum致力于和开发者共同打造灵活高效、易学易用的量子计算框架，持续提升MindSpore Quantum功能、性能和易用性，助力量子计算技术研究和创新。\",\n            \"description_en\": \"MindSpore Quantum is dedicated to building a flexible, efficient, easy-to-learn, and easy-to-use quantum computing framework for developers, continuously improving the functions, performance, and usability of MindSpore Quantum to facilitate quantum computing technology research and innovation.\",\n            \"created_on\": \"2021-03-27\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"meeting_url\": \"https://etherpad.mindspore.cn/p/sig-MindSpore-Quantum-meetings\",\n            \"maintainers\": [{\n                \"gitee_id\": \"donghufeng\",\n                \"name\": \"donghufeng\",\n                \"organization\": \"Tsinghua University\",\n                \"email\": \"thuxuxs@163.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"dsdsdshe\",\n                \"name\": \"周俊园\",\n                \"organization\": \"Huawei\",\n                \"email\": \"jedzhou99@163.com\",\n                \"role\": \"maintainer\"\n            }],\n            \"repositories\": [{\n                \"repo\": [\"mindspore/mindquantum\"],\n                \"committers\": [{\n                    \"gitee_id\": \"herunhong\",\n                    \"name\": \"何润洪\",\n                    \"organization\": \"Ocean University of China\",\n                    \"email\": \"runhong93@126.com\",\n                    \"role\": \"committer\"\n                }],\n                \"contributors\": [{\n                    \"gitee_id\": \"dorothy20212021\",\n                    \"name\": \"dorothy\",\n                    \"organization\": \"Huawei\",\n                    \"email\": \"zhaohaiying99@163.com\"\n                }, {\n                    \"gitee_id\": \"zhou-xu3\",\n                    \"name\": \"周旭\",\n                    \"organization\": \"Sun Yat-sen University\",\n                    \"email\": \"zhoux229@mail2.sysu.edu.cn\"\n                }, {\n                    \"gitee_id\": \"xie-qingxing\",\n                    \"name\": \"谢晴兴\",\n                    \"organization\": \"Wuhan University\",\n                    \"email\": \"634436649@qq.com\"\n                }, {\n                    \"gitee_id\": \"he-tianshen\",\n                    \"name\": \"何天深\",\n                    \"organization\": \"Fudan University\",\n                    \"email\": \"NA\"\n                }, {\n                    \"gitee_id\": \"tang_love_coke\",\n                    \"name\": \"唐加亮\",\n                    \"organization\": \"Shanghai University\",\n                    \"email\": \"NA\"\n                }, {\n                    \"gitee_id\": \"Eta-Chu\",\n                    \"name\": \"储贻达\",\n                    \"organization\": \"Chongqing University\",\n                    \"email\": \"NA\"\n                }, {\n                    \"gitee_id\": \"arapat-ablimit\",\n                    \"name\": \"阿拉帕提·阿不力米提\",\n                    \"organization\": \"Ocean University of China\",\n                    \"email\": \"NA\"\n                }, {\n                    \"gitee_id\": \"chl9788\",\n                    \"name\": \"陈泓霖\",\n                    \"organization\": \"University of Science and Technology of China\",\n                    \"email\": \"NA\"\n                }]\n            }],\n            \"repo_count\": 1,\n            \"repos\": [{\n                \"repo_name\": \"mindspore/mindquantum\"\n            }]\n        }, {\n            \"name\": \"AKG\",\n            \"description\": \"MindSpore AKG SIG 专注于利用 MindSpore AKG 在算子编译和算子生成领域的技术积累，持续完善软件功能，拓展社区生态，为科研人员、教师、学生以及对此领域有深厚兴趣和强大影响力的人们提供一个高效易用的图计算融合编译器，同时提供一个共同交流合作的平台。\",\n            \"description_en\": \"The MindSpore AKG SIG focuses on leveraging the technical accumulation of MindSpore AKG in the field of operator compilation and operator generation, continuously improving software functionality, expanding the community ecosystem, and providing an efficient and easy-to-use graph computation fusion compiler for researchers, teachers, students, and those with a deep interest and strong influence in this field, while also providing a platform for collaborative communication.\",\n            \"mailing_list\": \"dev@mindspore.cn\",\n            \"maintainers\": [{\n                \"gitee_id\": \"anyrenwei\",\n                \"name\": \"Zhang, Renwei\",\n                \"email\": \"zhangrenwei1@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"zichun_ye\",\n                \"name\": \"Ye, Zichun\",\n                \"email\": \"zichun.ye@huawei.com\",\n                \"role\": \"maintainer\"\n            }, {\n                \"gitee_id\": \"corleoneliu\",\n                \"name\": \"Liu, Chao\",\n  