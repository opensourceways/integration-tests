================================
var name = 'default'
var avg_name = 'avg_score'
if (mode == 'special') {
    name = community
    avg_name = 'special_avg_score'
}
var metric_query = """
SELECT
    config
FROM config_health
WHERE community=#{name};
"""
var config = db.select(metric_query)[0].config.value::json
var interval = config.get('interval') or '1 years'
var metrics = config.get('metric_list').keySet()
var query = 'array_agg(created_at ORDER BY created_at) AS date'
metrics.each(it => query += ',' + `array_agg(${it} ORDER BY created_at) AS ${it}`)
metrics.each(it => query += ',' + `array_agg(${it}_value ORDER BY created_at) AS ${it}_value`)
var sqlstr = """
SELECT 
    ${query}
FROM dws_community_health_metric
WHERE community=#{community} AND created_at <= CURRENT_DATE
      <if test="date != null and date != ''">
          AND created_at >= #{date}:: DATE - INTERVAL '1 year'
      </if>
"""
var resp = db.select(sqlstr)[0]
var result = {}
for(key, value in resp){
    result[key] = value.getArray()
}
return result
