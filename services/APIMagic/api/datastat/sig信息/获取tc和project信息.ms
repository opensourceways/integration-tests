================================
import org.ssssssss.script.parsing.ast.statement.Return
import ch.qos.logback.classic.Level
var community_temp = community;
if ("ascend".equals(community_temp) || "Ascend".equals(community_temp) ){
    community_temp = "ascendpublic"
}
var sql_project = """ 
select a.project_name,a.tc_members,b.sig_names from (
 SELECT 
    project_name,
    JSONB_AGG(
        JSONB_BUILD_OBJECT(
            'user_login', user_login,
            'user_name', user_name,
            'email', email
        ) ORDER BY user_login
    ) AS tc_members
FROM fact_${community_temp}_sig_user 
WHERE role = 'tc_member' 
GROUP BY project_name
) a left join (
SELECT  project_name,  ARRAY_AGG(DISTINCT sig_name ) AS sig_names
    FROM fact_${community_temp}_sig_user
    WHERE sig_name IS NOT NULL
    GROUP BY project_name
) b 
on a.project_name=b.project_name"""
resp = db.select(sql_project)
resp.each(it =>{
    it['sig_names'] = it.sig_names.getArray();
    it['tc_members'] = it.tc_members.value::json;
} )
return resp
