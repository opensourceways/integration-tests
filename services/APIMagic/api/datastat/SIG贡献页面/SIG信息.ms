================================
var community_temp = community

if ("mindspore".equals(community_temp) || "Mindspore".equals(community_temp) ){
    community_temp = "mindsporeatomgit"
}
var sqlstr = """
WITH user_roles AS (
    SELECT 
        sig_name,
        array_agg(DISTINCT user_login) FILTER (WHERE role = 'maintainer') AS maintainer,
        array_agg(DISTINCT user_login) FILTER (WHERE role = 'committer') AS committer
    FROM fact_${community_temp}_sig_user
    WHERE is_removed is null
        <if test="sig != null and sig != ''">
            AND sig_name = #{sig}
        </if>
    GROUP BY sig_name
)

SELECT 
    fcsd.sig_json, 
    ur.maintainer, 
    ur.committer
FROM fact_${community_temp}_sig_detail_info fcsd
LEFT JOIN user_roles ur ON fcsd.sig_name = ur.sig_name
WHERE fcsd.is_removed is null and fcsd.sig_name <> 'Private'
    <if test="sig != null and sig != ''">
        AND fcsd.sig_name = #{sig}
    </if>
;"""

var res = db.select(sqlstr)

var ans = []
for (it in res) {
    var sig_info = it['sig_json']::json
    var repos = []
    var committers = new HashSet()
    if (sig_info.containsKey('repositories')) {
        for (key in sig_info.get('repositories')) {
            repos.addAll(key['repo'])
            if (key.containsKey('committers')) {
                committers.addAll(key.get('committers'))
            }
        }
    }

    sig_info['repositories'] = repos
    sig_info['committer_info'] = committers
    sig_info['maintainer_info'] = sig_info.get('maintainers') || []
    sig_info['sig_name'] = sig_info.get('name')

    maintainer = it.maintainer == null ? [] : it.maintainer.getArray()
    sig_info['maintainers'] = maintainer

    committer = it.committer == null ? [] : it.committer.getArray()
    sig_info['committers'] = committer

    ans.add(sig_info)

}

ans = sig == null || sig == '' ? ans : ans[0]

return ans 