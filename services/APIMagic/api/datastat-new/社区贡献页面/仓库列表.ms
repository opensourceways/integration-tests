var coreRepo = ['openGauss-server','CBB','DCF','DCC','DMS','openGauss-OM','CM','DSS']
var sqlstr = """
SELECT 
    repo_path as repo
FROM 
    fact_${community}_repo
WHERE 
    is_removed IS NULL
    <if test="community == 'openubmc'">
        AND private = 'false'
    </if>
GROUP BY 
    repo_path;"""
var resp = db.select(sqlstr)
return resp.map((item)=>{
    isCoreRepo : coreRepo.contains(item.repo)? "1" : "0",
    repo : item.repo
});
