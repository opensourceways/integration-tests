================================
contributeType = contributeType.toLowerCase()
if (contributeType == 'comment') {
    sum_field = comment_type == 'normal' ? `valid_comment_incre` : comment_type == 'command' ? `comment_incre - valid_comment_incre` : `comment_incre`
}
else {
    sum_field = contributeType == 'pr' ? `merged_pr_incre` : `${contributeType}_incre`
}
var sql = """
with sig_user as (
    SELECT 
        user_login,
        sig_name,
        role,
    ROW_NUMBER() OVER (PARTITION BY (user_login, sig_name) ORDER BY CASE role WHEN 'maintainer' THEN 1 WHEN 'committer' THEN 2 ELSE 3 END) AS rn
    FROM fact_${community}_sig_user
    WHERE is_removed is null
        <if test="sig != null and sig != ''">
            AND sig_name = #{sig}
        </if>
    GROUP BY user_login, sig_name, role
),
sig_contribute as (
	SELECT sig_name, user_login, sum(${sum_field}) AS contribute
	FROM dws_${community}_contribute_sig_user_daily
	WHERE 1 = 1 
        <if test="sig != null and sig != ''">
            AND sig_name = #{sig}
        </if>
        <if test="start != null and start != ''">
            AND date >= to_timestamp(#{start}/1000)
        </if>
        <if test="end != null and end != ''">
            AND date <= to_timestamp(#{end}/1000)
        </if>
	GROUP BY sig_name, user_login
)
SELECT
    COALESCE(dcc.user_login, su.user_login) AS user_login, 
    COALESCE(su.role, 'contributor') AS usertype,
    SUM(COALESCE(dcc.contribute, 0)) AS contribute
FROM sig_contribute dcc
FULL OUTER JOIN sig_user su
ON dcc.user_login = su.user_login AND dcc.sig_name = su.sig_name
    AND su.rn = 1
GROUP BY COALESCE(dcc.user_login, su.user_login), COALESCE(su.role, 'contributor')
HAVING COALESCE(su.role, 'contributor') <> 'contributor' or SUM(COALESCE(dcc.contribute, 0)) > 0
ORDER BY contribute desc;
"""
var resp = db.select(sql)
return resp    
