var sqlstr = """
SELECT 
    user_login, array_agg(DISTINCT source)
FROM 
    dwm_${community}_contribute_user dccu
WHERE 
    d1_time IS NOT NULL 
    AND NOT EXISTS (SELECT 1 FROM fact_community_robot_user fcr WHERE fcr.user_login = dccu.user_login)
GROUP BY 
    user_login;"""
var result = {}
var resp = db.select(sqlstr)
for (item in resp) {
    result[item['user_login']] = item['array_agg'].getArray()
}
return result
