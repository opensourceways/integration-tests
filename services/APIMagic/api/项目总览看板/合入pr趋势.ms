================================
import '@/util/timestamp2Date' as timestamp2Date;
Date start = timestamp2Date(body.start);
Date end = timestamp2Date(body.end);
// 社区
var community = body.community.toLowerCase();
// 社区
var repo_path = body.repo_path;
var repo_arr = repo_path != null ? repo_path.split("/"):[];
var namespace = "";
if(repo_arr.size() == 2){
    namespace = repo_arr[0];
    repo_path = repo_arr[1];
}
// 贡献表
var contributeTable = "dws_" + community + "_contribute_repo_daily";
// 华为开发者：人数，合入pr数
// 非华为开发者：人数，合入pr数
var internal_sql = """
WITH date_series AS (
-- 生成从最早访问日期到当前日期的日期序列
  SELECT
    generate_series ( #{start}, #{end}, '1 day' :: INTERVAL ) :: DATE AS date
),
data as (
    SELECT 
    date,
    sum(merged_pr_incre) as merged_pr_incre
    FROM ${contributeTable}
    where date::DATE BETWEEN #{start} AND #{end} and private = 'false'
    <if test="namespace != null and namespace != ''">
        and namespace = #{namespace}
    </if>
    <if test="repo_path != null and repo_path != ''">
        and repo_path = #{repo_path}
    </if>
    group by date
),
joined_data AS (
    -- 将完整的日期和组合表与实际的访问数据进行左连接
    SELECT 
        ds.date,
        COALESCE(d.merged_pr_incre, 0) AS merged_pr_incre
    FROM date_series ds
    LEFT JOIN data d ON ds.date = d.date
)
select * from joined_data
order by date asc
""";
var internal_data = db.select(internal_sql);
return internal_data;
