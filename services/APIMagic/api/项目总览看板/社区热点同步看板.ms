import hwcloud;
var community = body.community.toLowerCase();

// 华为云 AK/SK 签名（SDK-HMAC-SHA256，经 hwcloud 模块），ak/sk 存 PG fact_token(platform='huawei_cloud_ak'/'huawei_cloud_sk')
var akRow = db.select("""
SELECT
    token
FROM fact_token
WHERE platform = 'huawei_cloud_ak'
""")
var skRow = db.select("""
SELECT
    token
FROM fact_token
WHERE platform = 'huawei_cloud_sk'
""")

var resp = hwcloud.runJob(akRow[0]["token"], skRow[0]["token"], "hotspot_prod", [
        {
            "name": "community",
            "value": community
        }
    ])

return resp.status
 