================================
// 前端传入的 start/end 为毫秒时间戳（long）。
// 按 interval（day/week/month）对齐到完整周期边界：start 截断到所属周期起点，
// end 扩展到所属周期终点（+1 周期），使每个周期桶覆盖该周期完整数据，
// 不受 start/end 落在周期内何处的影响（如月度：1/15 起 与 1/31 起，1 月值相同）。
// 周期去重：周/月桶内用 count(distinct user_login)，同一用户在一周/月内多日活跃只计 1 次
// （日桶则按天分别计数）。
// period_bounds CTE 计算对齐后的 [period_start, period_end) 半开区间供各数据源统一使用。
var start = body.start;
var end = body.end;
// 服务平台
var source = body.source;
// 组织
var orgList = body.orgList;
// 内外部
var internalList = body.internalList;
// 是否私仓
var private = body.private;
// 用户类比: D0,D1,D2
var levelList = body.levelList;
var level = levelList[0];
// 用户贡献类型: pr,issue,comment（D0/无下钻事件时前端不传 eventList，需防空指针）
var eventList = body.eventList;
var event = (eventList != null && eventList.size() > 0) ? eventList[0] : null;
// 统计周期：daily-天，week-周，month-月
var interval = body.interval;
if(interval == 'daily'){
    interval = 'day'
}
var community = body.community.toLowerCase();
// 仓库路径（可选，不为空时按仓库维度统计活跃人数）
var repo_path = body.repo_path;

// ── 活跃用户日中间表（#1439）─────────────────────────────────────────────
// 直接查 dws_{c}_active_user_daily(社区维度) / dws_{c}_active_repo_user_daily(仓库维度)：
// 预聚合好的「日×用户×维度 + D0/D1/D2 布尔标志位」小表，毫秒级返回。周/月区间在查询时按
// date_trunc(interval) 分桶 + count(distinct user_login) 去重——同一用户一周/月内多日活跃只
// 计 1 次（与日桶按天分别计数区分）。中间表由 om-dataarts 的 active_user_daily 任务全量重建
// （口径：SWF + 贡献 + co-authored PR，机器人已过滤），生产环境经 维度贡献统计.job 为每个社区构建。
var activeTable = (repo_path != null && repo_path != '')
    ? ('dws_' + community + '_active_repo_user_daily')
    : ('dws_' + community + '_active_user_daily');
// level/event → 标志位 OR 条件（与中间表 is_swf/is_pr/is_issue/is_comment/is_merged_pr/is_coauthor 对齐）
var activeCond = '';
if (level == 'D2') {
    activeCond = '(is_merged_pr OR is_coauthor)';
} else if (event == null || event == '') {
    activeCond = (level == 'D0')
        ? '(is_swf OR is_pr OR is_issue OR is_comment OR is_coauthor)'
        : '(is_pr OR is_issue OR is_comment OR is_coauthor)';
} else if (event == 'pr') {
    activeCond = '(is_pr OR is_coauthor)';
} else if (event == 'issue') {
    activeCond = 'is_issue';
} else if (event == 'comment') {
    activeCond = 'is_comment';
}

if (repo_path != null && repo_path != '') {
    // 仓库维度活跃统计（查仓库维度活跃中间表 dws_{c}_active_repo_user_daily）
    var fastRepoSql = """
WITH date_series AS (
  SELECT
    generate_series ( (to_timestamp(#{start}/1000))::date, (to_timestamp(#{end}/1000))::date, '1 day' :: INTERVAL ) :: DATE AS date
),
period_bounds AS (
  SELECT
    date_trunc('${interval}', MIN(date)) AS period_start,
    (date_trunc('${interval}', MAX(date)) + '1 ${interval}'::INTERVAL) AS period_end
  FROM date_series
),
group_series AS (
    SELECT
    <if test="interval == 'day'">
        date_trunc('day', date)::DATE as date
    </if>
    <elseif test="interval == 'week'">
        DISTINCT date_trunc('week', date)::DATE as date
    </elseif>
    <else>
       DISTINCT date_trunc('month', date)::DATE as date
    </else>
    from date_series
),
repo_active AS (
    SELECT date_trunc('${interval}', date)::DATE as period_date,
           count(distinct namespace || '_' || repo_path || '_' || user_login) as increase
    FROM ${activeTable}
    <where>
        repo_path = #{repo_path}
        AND date >= (SELECT period_start FROM period_bounds)::date
        AND date < (SELECT period_end FROM period_bounds)::date
        AND ${activeCond}
        AND user_login != ''
        <if test="source != null and source != ''">
            AND source = #{source}
        </if>
        <if test="orgList != null and orgList.size() > 0">
            AND namespace in
            <foreach collection="orgList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="internalList != null and internalList.size() > 0">
            AND internal in
            <foreach collection="internalList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="private != null and private != ''">
            AND private = #{private}
        </if>
    </where>
    GROUP BY date_trunc('${interval}', date)::DATE
),
joined_data AS (
    SELECT
        gs.date,
        COALESCE(d.increase, 0) AS increase
    FROM group_series gs
    LEFT JOIN repo_active d ON gs.date = d.period_date
)
SELECT
    <if test="level == 'D0' and (event == null or event == '')">
        'D0' as level_type,
    </if>
    <if test="level == 'D0' and event == 'pr'">
        'D0' as level_type,
        'pr' as event_type,
    </if>
    <if test="level == 'D0' and event == 'issue'">
        'D0' as level_type,
        'issue' as event_type,
    </if>
    <if test="level == 'D0' and event == 'comment'">
        'D0' as level_type,
        'comment' as event_type,
    </if>
    <if test="level == 'D1' and event == null">
        'D1' as level_type,
    </if>
    <if test="level == 'D1' and event == ''">
        'D1' as level_type,
    </if>
    <if test="level == 'D1' and event == 'pr'">
        'D1' as level_type,
        'pr' as event_type,
    </if>
    <if test="level == 'D1' and event == 'issue'">
        'D1' as level_type,
        'issue' as event_type,
    </if>
    <if test="level == 'D1' and event == 'comment'">
        'D1' as level_type,
        'comment' as event_type,
    </if>
    <if test="level == 'D2'">
        'D2' as level_type,
        'pr' as event_type,
    </if>
    date, increase
FROM joined_data
ORDER BY date;
""";
    return db.select(fastRepoSql)
}

// 社区维度活跃统计（查社区维度活跃中间表 dws_{c}_active_user_daily）
var fastSql = """
WITH date_series AS (
  SELECT
    generate_series ( (to_timestamp(#{start}/1000))::date, (to_timestamp(#{end}/1000))::date, '1 day' :: INTERVAL ) :: DATE AS date
),
period_bounds AS (
  SELECT
    date_trunc('${interval}', MIN(date)) AS period_start,
    (date_trunc('${interval}', MAX(date)) + '1 ${interval}'::INTERVAL) AS period_end
  FROM date_series
),
group_series AS (
    SELECT
    <if test="interval == 'day'">
        date_trunc('day', date)::DATE as date
    </if>
    <elseif test="interval == 'week'">
        DISTINCT date_trunc('week', date)::DATE as date
    </elseif>
    <else>
       DISTINCT date_trunc('month', date)::DATE as date
    </else>
    from date_series
),
community_active AS (
    SELECT date_trunc('${interval}', date)::DATE as period_date,
           count(distinct user_login) as increase
    FROM ${activeTable}
    <where>
        date >= (SELECT period_start FROM period_bounds)::date
        AND date < (SELECT period_end FROM period_bounds)::date
        AND ${activeCond}
        AND user_login != ''
        <if test="source != null and source != ''">
            AND source = #{source}
        </if>
        <if test="orgList != null and orgList.size() > 0">
            AND namespace in
            <foreach collection="orgList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="internalList != null and internalList.size() > 0">
            AND internal in
            <foreach collection="internalList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="private != null and private != ''">
            AND private = #{private}
        </if>
    </where>
    GROUP BY date_trunc('${interval}', date)::DATE
),
joined_data AS (
    SELECT
        gs.date,
        COALESCE(d.increase, 0) AS increase
    FROM group_series gs
    LEFT JOIN community_active d ON gs.date = d.period_date
)
SELECT
    <if test="level == 'D0' and (event == null or event == '')">
        'D0' as level_type,
    </if>
    <if test="level == 'D0' and event == 'pr'">
        'D0' as level_type,
        'pr' as event_type,
    </if>
    <if test="level == 'D0' and event == 'issue'">
        'D0' as level_type,
        'issue' as event_type,
    </if>
    <if test="level == 'D0' and event == 'comment'">
        'D0' as level_type,
        'comment' as event_type,
    </if>
    <if test="level == 'D1' and event == null">
        'D1' as level_type,
    </if>
    <if test="level == 'D1' and event == ''">
        'D1' as level_type,
    </if>
    <if test="level == 'D1' and event == 'pr'">
        'D1' as level_type,
        'pr' as event_type,
    </if>
    <if test="level == 'D1' and event == 'issue'">
        'D1' as level_type,
        'issue' as event_type,
    </if>
    <if test="level == 'D1' and event == 'comment'">
        'D1' as level_type,
        'comment' as event_type,
    </if>
    <if test="level == 'D2'">
        'D2' as level_type,
        'pr' as event_type,
    </if>
    date, increase
FROM joined_data
ORDER BY date;
""";
return db.select(fastSql)
