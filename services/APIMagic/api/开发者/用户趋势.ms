================================
import '@/util/timestamp2Date' as timestamp2Date;
Date start = timestamp2Date(body.start);
Date end = timestamp2Date(body.end);
// 服务平台
var source = body.source;
// 组织
var orgList = body.orgList; 
// 内外部
var internalList = body.internalList;
// 是否私仓
var private = body.private;
// 用户类比: D0,D1,D2
var levelList = body.levelList;
// 统计周期：daily-天，week-周，month-月
var interval = body.interval;
// 社区
var community = body.community.toLowerCase();
// 仓库路径（可选，不为空时按仓库维度统计）
var repo_path = body.repo_path;
// 社区用户信息（有 repo_path 时使用仓库维度表）
var userTable = (repo_path != null && repo_path != '') ? "dwm_"+community+"_contribute_user_repo" : "dwm_"+community+"_contribute_user";
var sql = """
WITH date_series AS (
-- 生成从最早访问日期到当前日期的日期序列
  SELECT
    generate_series ( #{start}, #{end}, '1 day' :: INTERVAL ) :: DATE AS date
),
fixed_levels AS (
    -- 固定的级别列表
    SELECT unnest(array['D0', 'D1', 'D2'])::text AS level_type
),
full_combinations AS (
    SELECT ds.date, fl.level_type
    FROM date_series ds
    CROSS JOIN fixed_levels fl
), 
filter_date AS (
    SELECT * from ${userTable}
    <where>
        and user_login not in (select user_login from fact_community_robot_user)
        <if test="source != null and source != ''">
            and source = #{source}
        </if>
        <if test="private != null and private != ''">
            and private = #{private}
        </if>
        <if test="orgList != null and orgList.size() > 0">
            and namespace in
            <foreach collection="orgList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="internalList != null and internalList.size() > 0">
            and internal in
            <foreach collection="internalList" item="item" open="(" separator="," close=")">
                #{item}
            </foreach>
        </if>
        <if test="repo_path != null and repo_path != ''">
            and repo_path = #{repo_path}
        </if>
    </where>
),
daily_user AS (
    SELECT
        'D0' as level_type,
        date_trunc('day', d0_time)::DATE as date,
        COUNT(DISTINCT user_login) AS new_count
    FROM filter_date
    where d0_time::DATE BETWEEN #{start} AND #{end}
    GROUP BY date_trunc('day', d0_time)::DATE
    union all
    SELECT
        'D1' as level_type,
        date_trunc('day', d1_time)::DATE as date,
        COUNT(DISTINCT user_login) AS new_count
    FROM filter_date
    WHERE d1_time IS NOT NULL and (d1_time::DATE BETWEEN #{start} AND #{end})
    GROUP BY date_trunc('day', d1_time)::DATE
    union all
    SELECT
        'D2' as level_type,
        date_trunc('day', d2_time)::DATE as date,
        COUNT(DISTINCT user_login) AS new_count
    FROM filter_date
    WHERE d2_time IS NOT NULL and (d2_time::DATE BETWEEN #{start} AND #{end})
    GROUP BY date_trunc('day', d2_time)::DATE
), 
joined_data AS (
    -- 将完整的日期和组合表与实际的访问数据进行左连接
    SELECT 
        fc.level_type,
        fc.date,
        COALESCE(d.new_count, 0) AS increase
    FROM full_combinations fc
    LEFT JOIN daily_user d ON fc.date = d.date AND fc.level_type = d.level_type
),
cumulative_data AS (
   SELECT
        level_type,
        date,
        sum(increase) as increase,
        SUM(sum(increase)) OVER (PARTITION BY level_type ORDER BY date ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS total
    FROM joined_data
    where
    <if test="levelList != null and levelList.size() > 0">
        level_type in
        <foreach collection="levelList" item="item" open="(" separator="," close=")">
            #{item}
        </foreach>
    </if>
    group by level_type, date
)
SELECT
    level_type,
    <if test="interval == 'daily'">
        date,
    </if>
    <elseif test="interval == 'week'">
        date_trunc('week', date)::DATE as date,
    </elseif>
    <else>
        date_trunc('month', date)::DATE as date,
    </else>
    sum(increase) as increase,
    max(total) as total
FROM cumulative_data
group BY level_type,
<if test="interval == 'daily'">
    date
</if>
<elseif test="interval == 'week'">
    date_trunc('week', date)::DATE
</elseif>
<else>
    date_trunc('month', date)::DATE
</else>
ORDER BY date;
""";
var result = db.select(sql);
return result
